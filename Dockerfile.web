FROM node:24-bookworm-slim AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

FROM node:24-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
RUN groupadd --gid 10001 mausam && useradd --uid 10001 --gid mausam --create-home mausam
COPY --from=build --chown=mausam:mausam /app/.next/standalone ./
COPY --from=build --chown=mausam:mausam /app/.next/static ./.next/static
COPY --from=build --chown=mausam:mausam /app/public ./public
USER mausam
EXPOSE 3000
CMD ["node", "server.js"]
