# Copy this file OUTSIDE the repository, chmod 600, and replace every placeholder.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_32_PLUS_CHARACTER_SECRET

MAUSAM_HOSTNAME=forecast.example.gov.in
MAUSAM_EXTERNAL_URL=https://forecast.example.gov.in
CORS_ORIGINS=https://forecast.example.gov.in

OIDC_ISSUER=https://id.example.gov.in/realms/weather
OIDC_AUDIENCE=mausamsetu
OIDC_JWKS_URL=https://id.example.gov.in/realms/weather/protocol/openid-connect/certs
OIDC_ALGORITHM=RS256
OIDC_ROLES_CLAIM=realm_access.roles
OIDC_MAX_TOKEN_AGE_SECONDS=3600

# Browser SSO edge. Use credentials issued specifically for this deployment.
OIDC_CLIENT_ID=mausamsetu-web
OIDC_CLIENT_SECRET=REPLACE_WITH_OIDC_CLIENT_SECRET
OIDC_COOKIE_SECRET=REPLACE_WITH_RANDOM_COOKIE_SECRET
OIDC_ALLOWED_EMAIL_DOMAINS=example.gov.in

# Keep the Earthdata file outside Git and owner-readable only (0600).
EARTHDATA_NETRC_PATH=/secure/path/earthdata.netrc
