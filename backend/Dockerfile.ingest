FROM python:3.12-slim
WORKDIR /app
COPY requirements.lock ./requirements.lock
RUN pip install --no-cache-dir -r requirements.lock
COPY requirements.ingest.lock ./requirements.ingest.lock
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential libexpat1 \
    && pip install --no-cache-dir -c requirements.lock -r requirements.ingest.lock \
    && apt-get purge -y --auto-remove build-essential \
    && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml .
COPY mausam ./mausam
RUN pip install --no-cache-dir --no-deps . \
    && useradd -m -u 10001 mausam \
    && mkdir /data /public /cache /backups \
    && chown mausam:mausam /data /public /cache /backups
USER mausam
ENV MAUSAM_DATA_DIR=/data PYTHONDONTWRITEBYTECODE=1
CMD ["python", "-m", "mausam.container_service"]
